[sub_resource type="Shader" id="Shader_ex68u"]
code = "shader_type canvas_item;

uniform float blur_amount : hint_range(0, 10) = 5.0;
uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;
void fragment() {
    vec4 sum = vec4(0.0);
    vec2 pixel_size = 1.0 / vec2(textureSize(screen_texture, 0));

    for (int i = -4; i <= 4; i++) {
        for (int j = -4; j <= 4; j++) {
            sum += texture(screen_texture, SCREEN_UV + vec2(float(i), float(j)) * pixel_size * blur_amount);
        }
    }
    COLOR = sum / 81.0; // 9x9 samples
}"

